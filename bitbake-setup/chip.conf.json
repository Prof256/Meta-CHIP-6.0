{
  "version": "1.0",
  "description": "Next Thing Co. C.H.I.P. Single Board Computer Build Configurations (Yocto 6.0 Wrynose)",
  "sources": {
    "bitbake": {
      "git-remote": {
        "remotes": {
          "origin": {
            "uri": "https://git.openembedded.org/bitbake"
          }
        },
        "branch": "2.18",
        "rev": "2.18"
      }
    },
    "openembedded-core": {
      "git-remote": {
        "remotes": {
          "origin": {
            "uri": "https://git.openembedded.org/openembedded-core"
          }
        },
        "branch": "wrynose",
        "rev": "wrynose"
      }
    },
    "meta-yocto": {
      "git-remote": {
        "remotes": {
          "origin": {
            "uri": "https://git.yoctoproject.org/meta-yocto"
          }
        },
        "branch": "wrynose",
        "rev": "wrynose"
      }
    },
    "meta-openembedded": {
      "git-remote": {
        "remotes": {
          "origin": {
            "uri": "https://git.openembedded.org/meta-openembedded"
          }
        },
        "branch": "wrynose",
        "rev": "wrynose"
      }
    },
    "meta-chip": {
      "git-remote": {
        "remotes": {
          "origin": {
            "uri": "https://github.com/Prof256/meta-chip-6.0"
          }
        },
        "branch": "main",
        "rev": "main"
      }
    }
  },
  "bitbake-setup": {
    "configurations": [
      {
        "name": "chip-poky-nand",
        "description": "C.H.I.P. with Poky Distro targeting Onboard NAND Flash (UBI/UBIFS)",
        "setup-dir-name": "chip-poky-nand",
        "bb-layers": [
          "openembedded-core/meta",
          "meta-yocto/meta-poky",
          "meta-yocto/meta-yocto-bsp",
          "meta-openembedded/meta-oe",
          "meta-openembedded/meta-python",
          "meta-openembedded/meta-networking",
          "meta-chip"
        ],
        "oe-fragments": [
          "machine/chip",
          "distro/poky",
          "storage/chip-nand"
        ]
      },
      {
        "name": "chip-poky-sd-usb",
        "description": "C.H.I.P. with Poky Distro targeting MicroSD Breakout / USB Boot (ext4/wic)",
        "setup-dir-name": "chip-poky-sd-usb",
        "bb-layers": [
          "openembedded-core/meta",
          "meta-yocto/meta-poky",
          "meta-yocto/meta-yocto-bsp",
          "meta-openembedded/meta-oe",
          "meta-openembedded/meta-python",
          "meta-openembedded/meta-networking",
          "meta-chip"
        ],
        "oe-fragments": [
          "machine/chip",
          "distro/poky",
          "storage/chip-sd-usb"
        ]
      },
      {
        "name": "chip-nodistro-nand",
        "description": "C.H.I.P. Minimal OpenEmbedded (nodistro) targeting Onboard NAND Flash (UBI/UBIFS)",
        "setup-dir-name": "chip-nodistro-nand",
        "bb-layers": [
          "openembedded-core/meta",
          "meta-openembedded/meta-oe",
          "meta-chip"
        ],
        "oe-fragments": [
          "machine/chip",
          "storage/chip-nand"
        ]
      },
      {
        "name": "chip-nodistro-sd-usb",
        "description": "C.H.I.P. Minimal OpenEmbedded (nodistro) targeting MicroSD / USB Boot",
        "setup-dir-name": "chip-nodistro-sd-usb",
        "bb-layers": [
          "openembedded-core/meta",
          "meta-openembedded/meta-oe",
          "meta-chip"
        ],
        "oe-fragments": [
          "machine/chip",
          "storage/chip-sd-usb"
        ]
      }
    ]
  }
}

